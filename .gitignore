# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- never commit real secrets; .env.example is a safe template
# (no real values) and is explicitly allowed back in below.
.env*
!.env.example

# scratch/local-only files that should never be committed
*.local.*
/scratch/
/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
 
# uploads
/public/uploads

# load-test run artifacts (transient state + reports for scripts_loadtest/*.mjs)
scripts_loadtest/loadtest_state.json
scripts_loadtest/report_*.json

# local Supabase CLI cache (e.g. `npx supabase --version`) -- not project data
/supabase/.temp/
